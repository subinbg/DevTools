#!/usr/bin/env bash
# A utility script to manage tools in this monorepo.
#
#   ./devtools status  [tool...]          pinned upstream ref vs latest upstream tag
#   ./devtools diff    <tool>             local changes relative to pristine upstream
#   ./devtools add     <tool>             import upstream at the ref pinned in tool.env
#   ./devtools update  <tool> <ref>       pull a newer upstream ref and merge it
#   ./devtools pin     <tool> <ref>       only record <ref> in tool.env (after a manual merge)
#   ./devtools test    <tool> [args...]   run the test stage
#   ./devtools build   <tool> [target]    run the build stage into tools/<tool>/dist/
#                                         linux-x64 (default) | linux-arm64 | darwin-arm64
#   ./devtools shell   <tool>             a shell in the toolchain image
#   ./devtools clean   <tool>             remove dist/, src/target, shell image and caches
#   ./devtools release <tool> [suffix]    tag release-<tool>-<ref>[-suffix] and push it
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGETS="linux-x64 linux-arm64 darwin-arm64"

usage() { sed -n '2,15p' "$0" >&2; exit 1; }

load() {
  TOOL="${1:?tool name required}"
  TOOL_DIR="$ROOT/tools/$TOOL"
  ENV_FILE="$TOOL_DIR/tool.env"
  [[ -f "$ENV_FILE" ]] || { echo "unknown tool '$TOOL' ($ENV_FILE missing)" >&2; exit 1; }
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  : "${UPSTREAM_REPO:?missing in $ENV_FILE}" "${UPSTREAM_REF:?missing in $ENV_FILE}"
  PREFIX="tools/$TOOL/src"
}

require_clean() {
  if [[ -n "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ]]; then
    echo "working tree is not clean; commit or stash first (git subtree needs a clean tree)" >&2
    exit 1
  fi
}

write_ref() {
  local tmp; tmp="$(mktemp)"
  sed "s|^UPSTREAM_REF=.*|UPSTREAM_REF=$1|" "$ENV_FILE" >"$tmp" && mv "$tmp" "$ENV_FILE"
}

# Latest squash commit for this prefix; its tree becomes the pristine upstream tree.
upstream_squash() {
  git -C "$ROOT" log --format=%H --grep="^git-subtree-dir: $PREFIX\$" -1
}

# ---------------------------------------------------------------- containers

platform_for() {
  case "$1" in
    linux-x64) echo linux/amd64 ;;
    linux-arm64) echo linux/arm64 ;;
    *) case "$(uname -m)" in arm64|aarch64) echo linux/arm64 ;; *) echo linux/amd64 ;; esac ;;
  esac
}

docker_build() {
  local platform="$1"; shift
  command -v docker >/dev/null || { echo "docker is required" >&2; exit 1; }
  docker build --progress=plain --platform "$platform" "$@" "$TOOL_DIR"
}

# ------------------------------------------------------------------ commands

cmd_add() {
  load "$1"; require_clean
  [[ -e "$ROOT/$PREFIX" ]] && { echo "$PREFIX already exists; use 'update'" >&2; exit 1; }
  git -C "$ROOT" subtree add --prefix="$PREFIX" --squash \
    -m "Import $TOOL $UPSTREAM_REF" "$UPSTREAM_REPO" "$UPSTREAM_REF"
}

cmd_pin() {
  load "$1"; local ref="${2:?new ref required}"
  write_ref "$ref"
  git -C "$ROOT" add "$ENV_FILE"
  git -C "$ROOT" commit -q -m "Pin $TOOL $ref" -- "$ENV_FILE"
  echo "$TOOL pinned to $ref"
}

cmd_update() {
  load "$1"; local ref="${2:?new ref required}"; require_clean
  [[ -e "$ROOT/$PREFIX" ]] || { echo "$PREFIX missing; use 'add'" >&2; exit 1; }
  if ! git -C "$ROOT" subtree pull --prefix="$PREFIX" --squash \
      -m "Update $TOOL $UPSTREAM_REF to $ref" "$UPSTREAM_REPO" "$ref"; then
    cat >&2 <<MSG

Merge stopped (most likely conflicts between your changes and upstream).
Resolve them under $PREFIX, then:
  git add -A $PREFIX && git commit
  ./devtools pin $TOOL $ref
MSG
    exit 1
  fi
  cmd_pin "$TOOL" "$ref"
}

cmd_diff() {
  load "$1"
  local squash; squash="$(upstream_squash)"
  [[ -n "$squash" ]] || { echo "no subtree squash commit found for $PREFIX" >&2; exit 1; }
  # Compare the pristine upstream tree with the tree at HEAD under the prefix.
  git -C "$ROOT" diff --stat=120 "$squash" "HEAD:$PREFIX" --
  git -C "$ROOT" diff "$squash" "HEAD:$PREFIX" -- | cat
}

cmd_status() {
  local tools=("$@")
  if [[ ${#tools[@]} -eq 0 ]]; then
    for d in "$ROOT"/tools/*/; do tools+=("$(basename "$d")"); done
  fi
  printf '%-10s %-10s %-10s %s\n' TOOL PINNED LATEST IMPORTED
  for t in "${tools[@]}"; do
    load "$t"
    local latest imported
    latest="$(git ls-remote --tags --refs "$UPSTREAM_REPO" 2>/dev/null \
      | awk -F/ '{print $NF}' | grep -E '^v?[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1)"
    imported=no; [[ -e "$ROOT/$PREFIX" ]] && imported=yes
    printf '%-10s %-10s %-10s %s\n' "$t" "$UPSTREAM_REF" "${latest:-?}" "$imported"
  done
}

cmd_test() {
  load "$1"; shift
  # --no-cache-filter: the tests run every time, even when the sources did not change.
  docker_build "$(platform_for native)" --target test --no-cache-filter test \
    --build-arg "TEST_ARGS=$*"
}

cmd_build() {
  load "$1"; local target="${2:-linux-x64}"
  [[ " $TARGETS " == *" $target "* ]] \
    || { echo "unknown target '$target' (one of: $TARGETS)" >&2; exit 1; }
  docker_build "$(platform_for "$target")" --target export \
    --build-arg "TARGET=$target" --build-arg "COMMIT=$(git -C "$ROOT" rev-parse --short HEAD)" \
    --output "type=local,dest=$TOOL_DIR/dist"
  ls -l "$TOOL_DIR/dist/$TOOL-$target"
}

cmd_shell() {
  load "$1"
  [[ -t 0 && -t 1 ]] || { echo "shell needs a terminal" >&2; exit 1; }
  docker_build "$(platform_for native)" --target base -t "devtools/$TOOL:dev"
  docker run --rm -it --init -v "$TOOL_DIR:/work" -w /work/src "devtools/$TOOL:dev" bash
}

cmd_clean() {
  load "$1"
  rm -rf "$TOOL_DIR/dist" "$TOOL_DIR/src/target"
  docker image rm -f "devtools/$TOOL:dev" >/dev/null 2>&1 || true
  # BuildKit's cache mounts (Go and cargo caches) are shared by all tools.
  docker builder prune -f --filter type=exec.cachemount >/dev/null
  echo "$TOOL: dist/, src/target, the shell image and the BuildKit cache mounts are removed"
}

# The tag is release-<tool>-<ref>[-suffix]; the workflow reads the tool name from it,
# so a tool name cannot contain a dash.
cmd_release() {
  load "$1"; local suffix="${2:-}"
  [[ "$TOOL" != *-* ]] || { echo "tool names with a dash cannot be released this way" >&2; exit 1; }
  local tag="release-$TOOL-$UPSTREAM_REF${suffix:+-$suffix}"
  git -C "$ROOT" tag -a "$tag" -m "$tag"
  git -C "$ROOT" push origin "$tag"
  echo "pushed tag $tag; the release workflow builds linux-x64 and darwin-arm64" \
       "and publishes a GitHub Release"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  add|update|pin|diff|status|test|build|shell|clean|release) "cmd_$cmd" "$@" ;;
  *) usage ;;
esac
